#!/bin/sh
# hq: the age identity of fnox-plugin-hq — create it, unlock it once per session, lock it.
# Same cache names and formats as lib/hq/keycache.lua (see README "Key cache").
#   hq keygen [file]     new passphrase-protected identity; prints its public key (age1…)
#   hq unlock [file]     ask for the passphrase once; cache the identity for HQ_KEY_TTL seconds (default 8 h)
#   hq lock [file]       drop the cached identity
#   hq status [file]     locked | unlocked (backend)
#   hq recipient [file]  print the public key (needs the identity unlocked or plain)
# file defaults to $HQ_IDENTITY_FILE or ~/.config/hq/identity.age; backend = $HQ_KEY_CACHE (auto|keyctl|macos|none).
set -eu

NAME=fnox-plugin-hq
PREFIX="$NAME:v1:"
TTL=${HQ_KEY_TTL:-28800}

die() { echo "hq: $*" >&2; exit 1; }

abspath() {
  case $1 in
    "~"/*) p="$HOME/${1#"~/"}" ;;
    /*) p=$1 ;;
    *) p="$(pwd)/$1" ;;
  esac
  printf '%s' "$p"
}

backend() {
  b=${HQ_KEY_CACHE:-auto}
  if [ "$b" = auto ]; then
    if [ "$(uname -s)" = Darwin ]; then b=macos
    elif command -v keyctl >/dev/null 2>&1; then b=keyctl
    else b=none; fi
  fi
  case $b in keyctl|macos|none) printf '%s' "$b" ;; *) die "unknown HQ_KEY_CACHE '$b' (auto, keyctl, macos, none)" ;; esac
}

# ---------- backends: get (stdout, exit 1 = miss), put (value on stdin), clear ----------
keyctl_find() { keyctl search @u user "$NAME:$1" 2>/dev/null; }
keyctl_get() { kid=$(keyctl_find "$1") || return 1; keyctl pipe "$kid" 2>/dev/null; }
keyctl_put() {
  # possess the user keyring from this session (some sessions don't link it), or setperm/timeout are refused
  keyctl link @u @s >/dev/null 2>&1 || true
  kid=$(keyctl padd user "$NAME:$1" @u) || die "keyctl padd failed"
  if ! { keyctl setperm "$kid" 0x3f0b0000 && keyctl timeout "$kid" "$TTL"; } >/dev/null; then
    # never leave an identity in the keyring without its timeout
    keyctl revoke "$kid" >/dev/null 2>&1 || true
    keyctl unlink "$kid" @u >/dev/null 2>&1 || true
    die "keyctl could not set perms/timeout"
  fi
}
keyctl_clear() { kid=$(keyctl_find "$1") || return 1; keyctl revoke "$kid" >/dev/null 2>&1 || true; keyctl unlink "$kid" @u >/dev/null 2>&1 || true; }

macos_get() {
  v=$(security find-generic-password -s "$NAME" -a "$1" -w 2>/dev/null) || return 1
  rest=${v#"$PREFIX"}
  [ "$rest" != "$v" ] || { macos_clear "$1"; return 1; }
  expiry=${rest%%:*}
  case $expiry in ''|*[!0-9]*) macos_clear "$1"; return 1 ;; esac
  if [ "$expiry" -le "$(date +%s)" ]; then macos_clear "$1"; return 1; fi
  printf '%s' "${rest#*:}" | base64 -d
}
macos_put() {
  case $1 in *'"'*|*'\'*) die "identity path must not contain quotes or backslashes" ;; esac
  payload="$PREFIX$(($(date +%s) + TTL)):$(base64 | tr -d '\n')"
  # the command goes to `security -i` on stdin, so the identity never shows in argv (ps)
  printf 'add-generic-password -U -s %s -a "%s" -w %s\n' "$NAME" "$1" "$payload" | security -i >/dev/null || die "security add-generic-password failed"
}
macos_clear() { security delete-generic-password -s "$NAME" -a "$1" >/dev/null 2>&1; }

none_get() { return 1; }
none_put() { cat >/dev/null; echo "hq: no key cache on this machine (HQ_KEY_CACHE=none): every command will ask" >&2; }
none_clear() { return 1; }

plain() { grep -q 'AGE-SECRET-KEY-' "$1" 2>/dev/null; }

cmd=${1:-help}
[ $# -gt 0 ] && shift
file=$(abspath "${1:-${HQ_IDENTITY_FILE:-$HOME/.config/hq/identity.age}}")

case $cmd in
  keygen)
    [ -e "$file" ] && die "$file exists"
    command -v age >/dev/null && command -v age-keygen >/dev/null || die "age and age-keygen must be on PATH"
    mkdir -p "$(dirname "$file")"
    umask 077
    id=$(age-keygen 2>/dev/null)
    echo "Choose a passphrase for $file (asked twice):" >&2
    printf '%s\n' "$id" | age -p -o "$file"
    printf '%s\n' "$id" | age-keygen -y
    ;;
  unlock)
    [ -r "$file" ] || die "no identity at $file (hq keygen)"
    plain "$file" && { echo "$file is not passphrase-protected: nothing to unlock" >&2; exit 0; }
    b=$(backend)
    if "${b}_get" "$file" >/dev/null; then echo "already unlocked ($b)" >&2; exit 0; fi
    id=$(age -d "$file") || die "wrong passphrase or no terminal"
    printf '%s\n' "$id" | "${b}_put" "$file"
    [ "$b" = none ] || echo "unlocked for $((TTL / 3600))h ($b)" >&2
    ;;
  lock)
    b=$(backend)
    if "${b}_clear" "$file"; then echo "locked ($b)" >&2; else echo "was not unlocked ($b)" >&2; fi
    ;;
  status)
    b=$(backend)
    if plain "$file"; then echo "plain identity (no unlock needed)"
    elif "${b}_get" "$file" >/dev/null; then echo "unlocked ($b)"
    else echo "locked ($b)"; exit 1; fi
    ;;
  recipient)
    if plain "$file"; then age-keygen -y "$file"
    else b=$(backend); id=$("${b}_get" "$file") || die "locked: hq unlock first"; printf '%s\n' "$id" | age-keygen -y || die "locked: hq unlock first"; fi
    ;;
  help|-h|--help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command '$cmd' (keygen, unlock, lock, status, recipient)" ;;
esac
